[Unit]
Description=Clawli Cloud Relay (WebSocket)
After=network.target

[Service]
Type=simple
User=nobody
WorkingDirectory=/opt/clawli-relay
ExecStart=/usr/bin/python3 /opt/clawli-relay/relay_server.py --host 0.0.0.0 --port 8900 --auth-token CHANGE-ME
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
